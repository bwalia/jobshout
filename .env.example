# -----------------------------------------------------------------------------
# JobShout environment
# -----------------------------------------------------------------------------
# Host port mappings (chosen to avoid conflicts with other services on the
# shared self-hosted runner VM 192.168.1.193 where 8080/8090/9000/9001/11434
# are already in use).
UI_HOST_PORT=3001
SERVER_HOST_PORT=8190
POSTGRES_HOST_PORT=5433
MINIO_API_HOST_PORT=9100
MINIO_CONSOLE_HOST_PORT=9110
# OLLAMA_HOST_PORT intentionally unset — we use the host's Ollama on :11434
# directly rather than running a compose-managed instance.

# PostgreSQL (container-internal URL – unchanged inside the compose network)
POSTGRES_USER=jobshout
POSTGRES_PASSWORD=jobshout
POSTGRES_DB=jobshout
DATABASE_URL=postgres://jobshout:jobshout@postgres:5432/jobshout?sslmode=disable

# JWT
JWT_SECRET=change-me-to-a-random-32-character-string
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# MinIO (container-internal endpoint)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_AVATARS=avatars
MINIO_BUCKET_KNOWLEDGE=knowledge

# Server
SERVER_PORT=:8080
# Comma-separated list of allowed CORS origins. Include the public dev domain
# and LAN origins so browsers hitting either can call the API.
CORS_ORIGINS=https://dev.jobshout.co.uk,http://localhost:3001,http://192.168.1.193:3001

# Next.js – browser-facing URLs (must be reachable from the user's browser).
# Uses the public HTTPS dev domain; wss:// avoids mixed-content blocking.
NEXT_PUBLIC_API_URL=https://dev-api.jobshout.co.uk
NEXT_PUBLIC_WS_URL=wss://dev-api.jobshout.co.uk

# -----------------------------------------------------------------------------
# Automated blog generator (LLM -> markdown -> HTML -> opsapi CMS draft)
# -----------------------------------------------------------------------------
# Writing articles always works and needs nothing below. Publishing does: it
# renders each article to HTML and creates a DRAFT post via opsapi's
# POST /api/v2/cms/posts. Drafts only — nothing this pipeline sends is visible
# on a public site until someone publishes it in the opsapi dashboard.
#
# All three of URL, API key and namespace are required before the Publish
# action is offered at all; leave any of them blank to keep publishing
# disabled.
#
# OPSAPI_API_KEY is a namespace-scoped opsapi API key ("opsk_..."), a
# long-lived machine credential — nothing to refresh or reseed. Mint one with
# ./scripts/opsapi-api-key.sh (or POST /api/v2/api-keys as a namespace admin)
# with scope {"cms":["create"]}. The key is shown once at creation; revoke it
# any time with DELETE /api/v2/api-keys/<uuid>.
#
# Blank here on purpose: this file is committed and a key must not be. Put the
# real value in .env (gitignored) or the deployment's secret store.
#
# The key must belong to OPSAPI_NAMESPACE (opsapi refuses it elsewhere), and
# that namespace needs the cms feature enabled. Note the API host is not the
# dashboard host: int-opsapi-ui.workstation.co.uk is the UI, and it calls the
# API below.
OPSAPI_BASE_URL=https://int-opsapi.workstation.co.uk
OPSAPI_API_KEY=
OPSAPI_NAMESPACE=workstation
OPSAPI_TIMEOUT=30s

# Byline on created posts, and the directory generated markdown is filed under
# (a label in the UI — nothing is written to disk).
BLOG_AUTHOR_NAME=JobShout Article Writer
BLOG_CONTENT_DIR=content/blogs

# Which model writes articles. Unset means OLLAMA_DEFAULT_MODEL, which is also
# what research uses — research makes many short calls where speed compounds,
# writing makes a few long ones where prose quality decides the result.
# BLOG_MODEL=qwen3-coder:30b
#
# BLOG_MODEL can be split when one model writes better prose than it returns
# JSON. Benchmarking two local models three times each, the better writer failed
# to return parseable JSON on two of six structured calls while the other went
# six for six — so the pipeline can send each kind of call where it does best.
# Both default to BLOG_MODEL, so leaving them unset changes nothing.
#
#   BLOG_PROSE_MODEL       draft, revise, expand — the article's text
#   BLOG_STRUCTURED_MODEL  plan, review — must return JSON
#
# BLOG_PROSE_MODEL=muse-glimmer:latest
# BLOG_STRUCTURED_MODEL=qwen3-coder:30b

# LLM / sidecar
#
# Two ways to reach Ollama:
#
#  1. Direct — a plain Ollama on the host. Containers reach it via
#     host.docker.internal (mapped via extra_hosts), reusing the models already
#     pulled on the host box. Leave OLLAMA_JWT_SECRET empty.
#
#  2. Through the shared auth gateway at https://ollama.workstation.co.uk,
#     which verifies a per-request HS256 JWT. Point OLLAMA_BASE_URL at it and
#     set OLLAMA_JWT_SECRET to the shared secret.
#
# OLLAMA_JWT_SECRET is intentionally blank here: this file is committed, and a
# signing secret must not be. Put the real value in .env (gitignored) or in the
# deployment's secret store. An empty value means "no gateway" and requests go
# out unsigned, which is correct for a direct Ollama.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=llama3:latest
OLLAMA_JWT_SECRET=
# Headroom for a large model that has to load before the first token.
OLLAMA_TIMEOUT=10m
# Context window requested per call. Ollama applies its own server-side default
# when num_ctx is absent, which silently truncates long prompts rather than
# refusing them — so it is always sent explicitly. Raise this to let agents use
# the larger windows big local models support (e.g. 32768, 131072).
OLLAMA_NUM_CTX=8192
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# ─── Image generation ────────────────────────────────────────────────────────
# Pictures come from mflux, which runs on Apple MLX and so lives OUTSIDE the
# cluster on the workstation — see image-service/ in this repository. The
# arrangement mirrors Ollama exactly: one service, every environment points at
# it, an HS256 JWT per request when it sits behind the gateway.
#
# Empty IMAGE_BASE_URL disables the local path. With no local path and no
# OPENAI_API_KEY, image generation is simply off: article runs still produce
# complete articles, and the generate_image tool is not offered to agents.
#
# To run the service on this machine:  cd image-service && ./run.sh
IMAGE_PROVIDER=mflux
IMAGE_BASE_URL=http://host.docker.internal:11435
IMAGE_DEFAULT_MODEL=z-image-turbo
# Blank for the same reason OLLAMA_JWT_SECRET is blank: this file is committed.
IMAGE_JWT_SECRET=
# A cold model load plus a queue wait is legitimately minutes, not seconds.
IMAGE_TIMEOUT=10m
IMAGE_OPENAI_MODEL=gpt-image-1
MINIO_BUCKET_IMAGES=images
# Whether every article run draws itself a cover. Off by default — a cover costs
# roughly 25 seconds of a single shared GPU, which is a cost worth choosing.
BLOG_COVER_IMAGES=false
PYTHON_SIDECAR_URL=http://python-sidecar:8001
PYTHON_SIDECAR_SECRET=change-me-sidecar-secret

# ─── Langfuse LLM observability (optional) ───────────────────────────────────
# Self-hosted Langfuse traces every LLM call the platform makes — the Go
# server's (article writing, research, agent executions, chat) and the
# python-sidecar's (langchain/langgraph runs) alike: full prompts and
# completions, per-model token counts and latency, and errors, grouped per
# run and per agent. See docs/langfuse.md.
#
#   docker compose --profile langfuse up -d     # UI at http://localhost:3002
#   ./scripts/langfuse_dashboard.py             # provision the dashboard
#
# The profile self-provisions an org/project/admin user and the API keys below
# on first boot (LANGFUSE_INIT_* in docker-compose.yml). Tracing stays OFF
# until both keys are set — uncomment to switch it on. The values here are the
# local-dev defaults baked into the compose file; replace every LANGFUSE_*
# secret before pointing anything shared at this.
#
# These three are read by BOTH the Python sidecar (LangChain/LangGraph runs)
# and the Go API (every LLM call it makes: article writing, research, agent
# executions, chat and intent). Set them in one place and everything is
# traced; set them only for the sidecar and the majority of real traffic
# stays invisible.
# LANGFUSE_PUBLIC_KEY=pk-lf-jobshout-local
# LANGFUSE_SECRET_KEY=sk-lf-jobshout-local
# In-network default; a server or sidecar running OUTSIDE compose needs
# LANGFUSE_HOST=http://localhost:3002 instead (the Go server defaults to that
# when the variable is unset).
# LANGFUSE_HOST=http://langfuse-web:3000
# Optional: the "environment" dimension stamped on every span, so several
# deployments can share one Langfuse project and stay separable. Defaults to
# "default"; the Helm chart sets it to the ring namespace.
# LANGFUSE_TRACING_ENVIRONMENT=local
#
# Langfuse UI login (created on first boot): admin@jobshout.local
# LANGFUSE_INIT_USER_PASSWORD=jobshout-langfuse
