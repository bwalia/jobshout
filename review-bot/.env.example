# GitHub Personal Access Token (needs `repo` scope).
# Reuse the gh CLI token with:  gh auth token
GITHUB_TOKEN=

# Absolute path to the local clone of the repo to review.
# Its `origin` remote determines which GitHub repo is used.
LOCAL_REPO_PATH=

OLLAMA_HOST=http://localhost:11434
MODEL=qwen3-coder:30b

# Optional. Rebuild the cached repo map once HEAD has moved this many commits
# past the map's build point. Lower = fresher but rebuilds more often. Default 30.
# MAP_REFRESH_COMMITS=30

# --- MCP server (app/mcp_server.py) ---

# Shared bearer token clients must present. Generate: openssl rand -hex 32
REVIEW_BOT_TOKEN=

# Optional. Port for the Streamable HTTP endpoint (default 8765).
# REVIEW_BOT_PORT=8765

# Optional. Public base URL clients use (default http://<hostname>:<port>).
# Set this to the Tailscale/LAN name you hand out, e.g. http://mac-studio:8765
# REVIEW_BOT_URL=

# Optional. Extra Host-header names allowed through DNS-rebinding protection,
# comma-separated (each is allowed on any port), e.g. mac-studio.tailnet.ts.net
# REVIEW_BOT_ALLOWED_HOSTS=

# --- Cluster HTTP API (app/http_server.py) ---
# Same REVIEW_BOT_TOKEN as MCP. Clones land here (PVC in k8s).
# REVIEW_BOT_CLONES_DIR=/data/clones
# REVIEW_BOT_CACHE_DIR=/data/cache
# OLLAMA_JWT_SECRET=          # same as JobShout's gateway secret; in-pod proxy mints x-api-key
