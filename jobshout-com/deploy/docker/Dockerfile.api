# JobShout.com API image. Built with buildx --platform linux/amd64 for k3s1.
FROM rust:1.90-bookworm AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY services ./services
COPY migrations ./migrations
RUN cargo build --release -p jobshout-com-api

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/jobshout-api /usr/local/bin/jobshout-api
ENV HOST=0.0.0.0 PORT=8088
EXPOSE 8088
CMD ["jobshout-api"]
