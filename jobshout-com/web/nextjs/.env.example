# JobShout.com web (Next.js)

NEXTAUTH_URL=http://127.0.0.1:3010
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Local/dev credentials login (no OAuth secrets). Requires APP_ENV=local|development|dev.
# Never set AUTH_DEV_LOGIN on int/test/acc/prod — the code also refuses ring APP_ENV values.
AUTH_DEV_LOGIN=true
APP_ENV=local

# Optional social IdPs — buttons appear enabled when both ID and secret are set.
# Do not invent values; copy from your IdP console or Vault (never paste into chat).
# Int/rings: WSLVault path jobshout-com/<ring>/oauth (see docs/development.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_ID=
APPLE_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Rust API
JOBSHOUT_COM_API_URL=http://127.0.0.1:8088
# Shared with the API for x-jobshout-internal-token (see make api / docker-compose).
JOBSHOUT_INTERNAL_TOKEN=

# OpsAPI CMS — published posts from one OpsAPI workspace appear on /insights.
# Both URL and namespace must be set, or the feature is off.
OPSAPI_URL=
OPSAPI_NAMESPACE=
# Secret from the OpsAPI webhook (POST /api/v2/cms/webhooks) pointed at
# https://<site>/hooks/opsapi. Without it the receiver answers 503 and posts
# still refresh every 5 minutes.
OPSAPI_WEBHOOK_SECRET=
# Workspace API key ("opsk_...") from OpsAPI, scoped to OPSAPI_NAMESPACE.
# Published posts are public, so /insights works without it.
OPSAPI_API_KEY=
